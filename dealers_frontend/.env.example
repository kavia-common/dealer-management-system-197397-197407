# Dealers Frontend Environment Variables (example)
#
# Create a `.env` file next to this one and set values as needed.
# NOTE (CRA): Only variables prefixed with REACT_APP_ are exposed to the browser.

# Base URL for the backend API.
# IMPORTANT: This app expects the base URL to include the "/api" prefix because hooks call
# paths like "/dealers", "/stock", etc.
#
# Default used by the app when missing:
#   http://localhost:3001/api
REACT_APP_API_BASE_URL=http://localhost:3001/api
